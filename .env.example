# Copier en .env puis adapter. Aucune de ces valeurs n'est obligatoire en local.

# port d'écoute
PORT=4000

# adresse publique (sert aux liens de récupération de panier et aux relances)
PUBLIC_URL=https://novadz.mondomaine.dz

# clé de chiffrement des jetons d'API transporteurs / relances
# si absente, une clé est générée dans data/.secret
# générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOVADZ_SECRET=

# chemin de la base SQLite (défaut : ./data/novadz.db)
NOVADZ_DB=

# envoi des e-mails (facultatif). La boutique peut aussi le remplir dans E-mails.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=commandes@boutique.dz
