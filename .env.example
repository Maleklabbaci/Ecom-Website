# Copier en .env puis adapter. Aucune de ces valeurs n'est obligatoire en local.

# port d'écoute (défaut du code : 3000)
PORT=3000

# NOVADZ_DEMO=1 : crée les boutiques de démonstration au premier démarrage
# (demo@novadz.dz / demo1234, admin@novadz.dz / admin1234). LOCAL UNIQUEMENT :
# ces mots de passe sont publics. Sans cette variable, seul un admin est créé,
# avec un mot de passe aléatoire affiché une fois dans la console.
# NOVADZ_DEMO=1

# Derrière Cloudflare ou un reverse-proxy : faire confiance à X-Forwarded-*
# (adresse IP réelle, https). Automatique si PUBLIC_URL est en https.
# NOVADZ_TRUST_PROXY=1

# adresse publique (sert aux liens de récupération de panier et aux relances)
PUBLIC_URL=https://novadz.mondomaine.dz

# clé de chiffrement des jetons d'API transporteurs / relances
# si absente, une clé est générée dans data/.secret
# générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOVADZ_SECRET=

# chemin de la base SQLite (défaut : ./data/novadz.db)
NOVADZ_DB=

# envoi des e-mails (facultatif). La boutique peut aussi le remplir dans E-mails.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=commandes@boutique.dz
